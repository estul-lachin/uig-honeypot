<!-- uig-honeypot demo Wazuh: rules for the pseudonymized honeypot copy (siem/pseudo.py), replayed by
     ./hp wazuh load. Every Cowrie event and every Suricata alert becomes an alert (level 3 or more),
     so alert counts equal row counts in Splunk (index honeypot_demo) and Sentinel (HP_Cowrie, HP_Suricata).
     IDs 100100-100299. ATT&CK IDs as of v20. -->
<group name="honeypot,cowrie,">

  <rule id="100100" level="3">
    <decoded_as>json</decoded_as>
    <field name="eventid">^cowrie.</field>
    <description>Cowrie: $(eventid)</description>
  </rule>

  <rule id="100101" level="8">
    <if_sid>100100</if_sid>
    <field name="eventid">^cowrie.login.success$</field>
    <description>Cowrie: login accepted for $(username) from $(src_ip)</description>
    <mitre><id>T1078</id></mitre>
    <group>authentication_success,</group>
  </rule>

  <rule id="100102" level="5">
    <if_sid>100100</if_sid>
    <field name="eventid">^cowrie.login.failed$</field>
    <description>Cowrie: login failed for $(username) from $(src_ip)</description>
    <mitre><id>T1110.001</id></mitre>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100103" level="3">
    <if_sid>100100</if_sid>
    <field name="eventid">^cowrie.command.input$</field>
    <description>Cowrie: command typed by $(src_ip)</description>
    <mitre><id>T1059.004</id></mitre>
  </rule>

  <!-- Persistence: the first matching child wins, so a command that touches both counts as the SSH key. -->
  <rule id="100110" level="12">
    <if_sid>100103</if_sid>
    <field name="input" type="pcre2">(?i)authorized_keys</field>
    <description>Cowrie: SSH authorized_keys modified by $(src_ip)</description>
    <mitre><id>T1098.004</id></mitre>
    <group>persistence,</group>
  </rule>

  <rule id="100111" level="10">
    <if_sid>100103</if_sid>
    <field name="input" type="pcre2">(?i)^(?!.*authorized_keys).*crontab</field>
    <description>Cowrie: cron job planted by $(src_ip)</description>
    <mitre><id>T1053.003</id></mitre>
    <group>persistence,</group>
  </rule>

  <rule id="100104" level="8">
    <if_sid>100100</if_sid>
    <field name="eventid">^cowrie.session.file_download$</field>
    <description>Cowrie: file downloaded by $(src_ip)</description>
    <mitre><id>T1105</id></mitre>
  </rule>

</group>

<group name="honeypot,ids,suricata,">

  <!-- Suricata_CL rows (vps/sentinel.py shape_suricata), not raw eve.json: no event_type, so the
       stock Suricata rules (86600...) do not fire. Severity 1 is the most severe. -->
  <rule id="100200" level="4">
    <decoded_as>json</decoded_as>
    <field name="signature_id">^\d+$</field>
    <description>Suricata: $(signature)</description>
  </rule>

  <rule id="100201" level="7">
    <if_sid>100200</if_sid>
    <field name="severity">^2$</field>
    <description>Suricata (severity 2): $(signature)</description>
  </rule>

  <rule id="100202" level="10">
    <if_sid>100200</if_sid>
    <field name="severity">^1$</field>
    <description>Suricata (severity 1): $(signature)</description>
  </rule>

</group>
