# Copy to .env.local (git-ignored). Never commit real values: this repo is public.
HP_HOST=            # VPS IP or an ssh config alias
HP_SSH_PORT=        # new port for the real sshd, e.g. a random one in 40000-60000
HP_USER=root
HP_PUBLIC_IP=       # VPS public IP; replaced with [honeypot-ip] in published stats
# HP_FAKE_HOSTNAME=db-backup-01
# HP_DATA_REPO=owner/uig-honeypot-data   # public repo the VPS pushes stats to (./hp publish-setup)
# COWRIE_IMAGE=cowrie/cowrie:3.1.3   # or uig/cowrie:3.1.3 from ./hp build-image
# HP_SPLUNK_PASSWORD=   # local Splunk admin password for ./hp siem (8+ characters)
# HP_ABUSEIPDB_KEY=     # AbuseIPDB API key: enrich.py looks up source IPs (check only, never reports)
# Microsoft Sentinel (sentinel.py): written by the one-time identity setup, see README
# HP_AZ_TENANT= / HP_AZ_CLIENT_ID= / HP_AZ_CLIENT_SECRET= / HP_AZ_DCE=https://...ingest.monitor.azure.com / HP_AZ_DCR=dcr-...
