#!/usr/bin/env bash
# hp: manage the uig-honeypot VPS from the Mac. Settings live in .env.local
# (git-ignored, never published). Run ./hp help.
set -euo pipefail
umask 022
ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
APP=/opt/uig-honeypot

die() { echo "error: $*" >&2; exit 1; }
say() { echo "==> $*"; }

[ -f "$ROOT/.env.local" ] || die "copy .env.example to .env.local and fill it in"
# shellcheck source=/dev/null
. "$ROOT/.env.local"
: "${HP_HOST:?set HP_HOST in .env.local}"
: "${HP_SSH_PORT:?set HP_SSH_PORT in .env.local}"
HP_USER=${HP_USER:-root}
COWRIE_IMAGE=${COWRIE_IMAGE:-cowrie/cowrie:3.1.3}

SSH_OPTS=(-o StrictHostKeyChecking=accept-new -o ConnectTimeout=15 -o ServerAliveInterval=30)
on22()   { ssh "${SSH_OPTS[@]}" -p 22 "$HP_USER@$HP_HOST" "$@"; }
remote() { ssh "${SSH_OPTS[@]}" -p "$HP_SSH_PORT" "$HP_USER@$HP_HOST" "$@"; }

cmd_prepare()  { on22 bash -s prepare "$HP_SSH_PORT" <"$ROOT/vps/harden.sh"; }
cmd_finalize() { remote bash -s finalize "$HP_SSH_PORT" <"$ROOT/vps/harden.sh"; }

sync_files() {
    say "Copying vps/ to $APP"
    remote "mkdir -p $APP"
    # COPYFILE_DISABLE keeps macOS ._ metadata files out of the tar.
    COPYFILE_DISABLE=1 tar -C "$ROOT/vps" -cf - . | remote "tar -xf - -C $APP --no-same-owner"
}

cmd_deploy() {
    sync_files
    {
        echo "COWRIE_IMAGE=$COWRIE_IMAGE"
        echo "HP_PUBLIC_IP=${HP_PUBLIC_IP:-}"
        echo "HP_SSH_PORT=$HP_SSH_PORT"
        echo "HP_FAKE_HOSTNAME=${HP_FAKE_HOSTNAME:-db-backup-01}"
        [ -z "${HP_DATA_REPO:-}" ] || echo "HP_DATA_REPO=git@github.com:$HP_DATA_REPO.git"
        [ -z "${HP_ABUSEIPDB_KEY:-}" ] || echo "HP_ABUSEIPDB_KEY=$HP_ABUSEIPDB_KEY"
        local v
        for v in HP_AZ_TENANT HP_AZ_CLIENT_ID HP_AZ_CLIENT_SECRET HP_AZ_DCE HP_AZ_DCR; do
            [ -z "${!v:-}" ] || echo "$v=${!v}"
        done
    } | remote "umask 077; cat >$APP/.env"
    remote bash -s install <"$ROOT/vps/harden.sh"
}

# For networks where Docker Hub is unreachable: build uig/cowrie on the VPS
# from source, using only in-country mirrors (see vps/build/build-image.sh).
# Then set COWRIE_IMAGE=uig/cowrie:<version> in .env.local.
cmd_build_image() {
    sync_files
    remote "bash $APP/build/build-image.sh"
}

# One-time: a deploy key on the VPS with write access to the data repo only.
cmd_publish_setup() {
    : "${HP_DATA_REPO:?set HP_DATA_REPO=owner/name in .env.local}"
    local pub
    pub=$(remote "k=$APP/data/deploy_key; mkdir -p $APP/data; [ -f \$k ] || ssh-keygen -q -t ed25519 -N '' -C uig-honeypot-vps -f \$k; cat \$k.pub")
    say "Adding the VPS deploy key (write) to $HP_DATA_REPO"
    gh repo deploy-key add - --repo "$HP_DATA_REPO" --allow-write --title "uig-honeypot VPS" <<<"$pub"
}

cmd_status() {
    remote "cd $APP && { docker compose ps 2>/dev/null || docker-compose ps; } \
        && systemctl --no-pager list-timers uig-aggregate.timer \
        && python3 -c 'import json; s=json.load(open(\"data/stats.json\")); print(\"generated\", s[\"generated_at\"]); print(json.dumps(s[\"totals\"], indent=1))'"
}

cmd_fetch() {
    local f
    mkdir -p "$ROOT/site/data"
    for f in stats.json recent.json; do
        remote "cat $APP/data/$f" >"$ROOT/site/data/$f.tmp"
        python3 -c 'import json,sys; json.load(open(sys.argv[1]))' "$ROOT/site/data/$f.tmp" \
            || die "fetched $f is not valid JSON"
        mv "$ROOT/site/data/$f.tmp" "$ROOT/site/data/$f"
    done
    say "Saved site/data/ (local preview only; git-ignored)"
}

# Raw logs for the local Splunk (siem/). Private: logs/ is git-ignored and
# holds attacker IPs. Rotated files never change, so only missing ones and the
# live cowrie.json are copied. Downloads and TTY recordings stay on the VPS.
cmd_pull() {
    local dir=$ROOT/logs f n=0
    mkdir -p "$dir"
    chmod 700 "$dir"
    while IFS= read -r f; do
        case "$f" in
            cowrie.json|cowrie.json.[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
            *) continue ;;
        esac
        [ "$f" != cowrie.json ] && [ -s "$dir/$f" ] && continue
        # </dev/null: ssh would otherwise eat the file list this loop reads
        remote "gzip -c $APP/data/var/log/cowrie/$f" </dev/null | gunzip >"$dir/$f.tmp"
        mv "$dir/$f.tmp" "$dir/$f"
        n=$((n + 1))
    done < <(remote "ls -1 $APP/data/var/log/cowrie")
    say "Copied $n file(s) to logs/ ($(du -sh "$dir" | cut -f1) in total)"
    # AbuseIPDB results from enrich.py, as a Splunk lookup (private: keyed by IP)
    if remote "test -f $APP/data/enrich/abuseipdb.json" </dev/null; then
        remote "cat $APP/data/enrich/abuseipdb.json" </dev/null >"$dir/abuseipdb.json.tmp"
        mv "$dir/abuseipdb.json.tmp" "$dir/abuseipdb.json"
        python3 "$ROOT/siem/gen_splunk.py" --reputation "$dir/abuseipdb.json"
    fi
}

# Local Splunk with the honeypot app (siem/). Needs HP_SPLUNK_PASSWORD in .env.local.
cmd_siem() {
    local compose=(docker compose -f "$ROOT/siem/docker-compose.yml")
    case "${1:-}" in
        up)
            : "${HP_SPLUNK_PASSWORD:?set HP_SPLUNK_PASSWORD in .env.local (8+ characters)}"
            mkdir -p "$ROOT/logs"
            python3 "$ROOT/siem/gen_splunk.py"
            # first-seen state for HP-02; written by Splunk, never committed
            local seen=$ROOT/siem/app/honeypot/lookups/honeypot_seen_urls.csv
            [ -f "$seen" ] || echo "dl_url,first_seen,last_seen,count,sources,is_new" >"$seen"
            local rep=$ROOT/siem/app/honeypot/lookups/ip_reputation.csv
            [ -f "$rep" ] || echo "ip,abuse_score,abuse_reports,abuse_reporters,abuse_last_reported,abuse_country,abuse_usage_type,abuse_isp,abuse_domain,abuse_is_tor,abuse_checked" >"$rep"
            SPLUNK_PASSWORD=$HP_SPLUNK_PASSWORD "${compose[@]}" up -d
            say "Splunk starts in 2-3 minutes: http://127.0.0.1:8010 (admin / HP_SPLUNK_PASSWORD)"
            ;;
        reload)
            python3 "$ROOT/siem/gen_splunk.py"
            SPLUNK_PASSWORD=${HP_SPLUNK_PASSWORD:-x} "${compose[@]}" exec -u splunk splunk \
                /opt/splunk/bin/splunk restart
            ;;
        down)  SPLUNK_PASSWORD=x "${compose[@]}" down ;;
        reset) SPLUNK_PASSWORD=x "${compose[@]}" down -v ;;
        *) die "usage: ./hp siem up | reload | down | reset (reset deletes the index)" ;;
    esac
}

# Network security monitoring: Suricata as a passive IDS on eth0 (vps/suricata/).
cmd_nsm_setup() {
    sync_files
    remote "bash $APP/suricata/setup.sh"
}
# Read-only summary; prints counts and signature names, never addresses.
cmd_nsm() { remote "python3 $APP/suricata/report.py ${1:-24}"; }

cmd_logs() { remote "tail -n 50 -F $APP/data/var/log/cowrie/cowrie.json"; }
cmd_ssh()  { ssh "${SSH_OPTS[@]}" -p "$HP_SSH_PORT" "$HP_USER@$HP_HOST"; }

cmd_help() {
    cat <<'EOF'
usage: ./hp <command>

First-time setup, in order:
  prepare      install packages; real sshd on 22 AND HP_SSH_PORT (uses port 22)
  finalize     drop 22 from the real sshd (connects on HP_SSH_PORT to prove it works)
  build-image  only if the VPS can't reach Docker Hub: build Cowrie on the VPS from source
  publish-setup  give the VPS a deploy key for HP_DATA_REPO (then deploy again)
  deploy       copy vps/ to the VPS, install units, start Cowrie

Day to day:
  status       containers, timer, current totals
  logs         follow the raw Cowrie log (private: never paste it anywhere public)
  fetch        download stats.json and recent.json into site/data/ for a local preview
  pull         copy the raw Cowrie logs into logs/ (private, git-ignored) for the local Splunk

Network security monitoring (Suricata, passive, alerts stay on the VPS):
  nsm-setup    add swap, install Suricata and the daily rule update, start it (idempotent)
  nsm [HOURS]  memory, packet drops, alert volume and top signatures (default: last 24 h)

Local Splunk (siem/, needs HP_SPLUNK_PASSWORD in .env.local):
  siem up      start Splunk on http://127.0.0.1:8010 with the honeypot app
  siem reload  regenerate the ATT&CK macro and restart Splunk after app changes
  siem down    stop it (the index is kept)
  siem reset   stop it and delete the index
  ssh          shell on the VPS
EOF
}

case "${1:-help}" in
    prepare|finalize|deploy|status|fetch|pull|logs|ssh|help) "cmd_${1}" ;;
    siem) cmd_siem "${2:-}" ;;
    build-image) cmd_build_image ;;
    nsm-setup) cmd_nsm_setup ;;
    nsm) cmd_nsm "${2:-24}" ;;
    publish-setup) cmd_publish_setup ;;
    *) cmd_help; exit 1 ;;
esac
