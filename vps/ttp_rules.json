{
  "_comment": "MITRE ATT&CK (v20) tagging for Cowrie events, shared by aggregate.py (Python re) and the Splunk app (siem/gen_splunk.py turns it into a macro). A rule has either 'event' (a Cowrie eventid) or 'pattern' (a regex over the command text; keep it to syntax both Python re and PCRE accept, with (?i) only at the start). Each technique is counted once per session.",
  "rules": [
    {"id": "T1110.001", "name": "Brute Force: Password Guessing", "tactic": "Credential Access",
     "event": "cowrie.login.failed"},
    {"id": "T1078", "name": "Valid Accounts", "tactic": "Initial Access",
     "event": "cowrie.login.success"},
    {"id": "T1082", "name": "System Information Discovery", "tactic": "Discovery",
     "pattern": "\\b(uname|lscpu|nproc|hostnamectl|dmidecode)\\b|/proc/(cpuinfo|version|meminfo)|\\bfree\\s+-[a-z]*[mhgb]"},
    {"id": "T1033", "name": "System Owner/User Discovery", "tactic": "Discovery",
     "pattern": "\\b(whoami|who)\\b|(^|[;&|]\\s*)(id|w)(\\s|;|$)"},
    {"id": "T1057", "name": "Process Discovery", "tactic": "Discovery",
     "pattern": "(^|[;&|]\\s*)ps(\\s|;|$)|\\b(pgrep|pidof)\\b|(^|[;&|]\\s*)top(\\s|;|$)"},
    {"id": "T1016", "name": "System Network Configuration Discovery", "tactic": "Discovery",
     "pattern": "\\b(ifconfig|netstat|ss\\s+-[a-z]*[tlnp])\\b|\\bip\\s+(a|addr|r|route|link)\\b|/etc/resolv\\.conf"},
    {"id": "T1083", "name": "File and Directory Discovery", "tactic": "Discovery",
     "pattern": "(^|[;&|]\\s*)(ls|find|locate)(\\s|;|$)"},
    {"id": "T1087.001", "name": "Account Discovery: Local Account", "tactic": "Discovery",
     "pattern": "/etc/passwd|\\bgetent\\s+passwd\\b"},
    {"id": "T1003.008", "name": "OS Credential Dumping: /etc/passwd and /etc/shadow", "tactic": "Credential Access",
     "pattern": "/etc/shadow"},
    {"id": "T1105", "name": "Ingress Tool Transfer", "tactic": "Command and Control",
     "pattern": "\\b(wget|curl|tftp|ftpget|scp)\\b|/dev/tcp/"},
    {"id": "T1105", "name": "Ingress Tool Transfer", "tactic": "Command and Control",
     "pattern": "echo\\s+-[a-z]*e[a-z]*\\s+[\\\"']?(\\\\x[0-9a-fA-F]{2}){4}"},
    {"id": "T1105", "name": "Ingress Tool Transfer", "tactic": "Command and Control",
     "event": "cowrie.session.file_download"},
    {"id": "T1105", "name": "Ingress Tool Transfer", "tactic": "Command and Control",
     "event": "cowrie.session.file_download.failed"},
    {"id": "T1059.004", "name": "Command and Scripting Interpreter: Unix Shell", "tactic": "Execution",
     "pattern": "[|;&]\\s*(ba)?sh(\\s|;|$)|\\b(ba)?sh\\s+(-c\\s|[./~]\\S*|\\S+\\.sh\\b)|\\./\\S+\\.sh\\b"},
    {"id": "T1059.008", "name": "Command and Scripting Interpreter: Network Device CLI", "tactic": "Execution",
     "pattern": "^\\s*(enable|system|shell|linuxshell|sh)\\s*$"},
    {"id": "T1027", "name": "Obfuscated Files or Information", "tactic": "Stealth",
     "pattern": "echo\\s+-[a-z]*e[a-z]*\\s+[\\\"']?(\\\\x[0-9a-fA-F]{2}){4}"},
    {"id": "T1222.002", "name": "File and Directory Permissions Modification: Linux and Mac Permissions", "tactic": "Defense Impairment",
     "pattern": "\\b(chmod|chattr)\\b"},
    {"id": "T1070.003", "name": "Indicator Removal: Clear Command History", "tactic": "Stealth",
     "pattern": "history\\s+-c|\\.bash_history|\\bHISTFILE\\b|unset\\s+HIST"},
    {"id": "T1070.004", "name": "Indicator Removal: File Deletion", "tactic": "Stealth",
     "pattern": "\\brm\\s+(-[a-zA-Z]*\\s+)*-[a-zA-Z]*[rf]"},
    {"id": "T1686", "name": "Disable or Modify System Firewall", "tactic": "Defense Impairment",
     "pattern": "\\bufw\\s+disable\\b|\\biptables\\s+(-F|--flush)\\b|\\b(systemctl|service)\\s+\\S*\\s*firewalld"},
    {"id": "T1685", "name": "Disable or Modify Tools", "tactic": "Defense Impairment",
     "pattern": "\\bsetenforce\\s+0\\b|\\b(systemctl|service)\\s+\\S*\\s*(apparmor|aliyun|aegis)"},
    {"id": "T1053.003", "name": "Scheduled Task/Job: Cron", "tactic": "Persistence",
     "pattern": "\\bcrontab\\b|/etc/cron|/var/spool/cron"},
    {"id": "T1098.004", "name": "Account Manipulation: SSH Authorized Keys", "tactic": "Persistence",
     "pattern": "authorized_keys"},
    {"id": "T1098", "name": "Account Manipulation", "tactic": "Persistence",
     "pattern": "\\b(chpasswd|usermod|useradd|adduser)\\b|(^|[;&|]\\s*)passwd(\\s|;|$)"},
    {"id": "T1496", "name": "Resource Hijacking", "tactic": "Impact",
     "pattern": "(?i)xmrig|minerd|cpuminer|stratum\\+(tcp|ssl)|c3pool|nicehash|monero|cryptonight"}
  ]
}
