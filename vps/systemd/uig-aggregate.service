[Unit]
Description=Build public honeypot stats and prune old raw logs

[Service]
Type=oneshot
UMask=0022
EnvironmentFile=-/opt/uig-honeypot/.env
WorkingDirectory=/opt/uig-honeypot
# AbuseIPDB lookups (check only). Best effort: no key or no network must not stop the stats.
ExecStartPre=-/usr/bin/python3 /opt/uig-honeypot/enrich.py \
  --logs data/var/log/cowrie --cache data/enrich/abuseipdb.json "--exclude-ip=${HP_PUBLIC_IP}"
ExecStart=/usr/bin/python3 /opt/uig-honeypot/aggregate.py \
  --logs data/var/log/cowrie --state data/state \
  --out data/stats.json --recent-out data/recent.json --reports data/reports \
  --geoip data/geoip/dbip-city-lite.mmdb --reputation data/enrich/abuseipdb.json \
  "--redact=${HP_PUBLIC_IP}"
# Raw logs, TTY recordings and downloads are kept for 30 days only; the
# partials in data/state keep the history.
ExecStartPost=/usr/bin/find data/var/log/cowrie -name 'cowrie.json.*' -mtime +30 -delete
ExecStartPost=/usr/bin/find data/var/lib/cowrie/tty data/var/lib/cowrie/downloads -type f -mtime +30 -delete
# Run the detections.uig.me rules on the same logs (best effort, see detect.py).
ExecStartPost=-/usr/bin/python3 /opt/uig-honeypot/detect.py \
  --logs data/var/log/cowrie --suricata-logs /var/log/suricata \
  --out data/detections.json --rules-cache data/state/detections-rules.json \
  "--redact=${HP_PUBLIC_IP}" "--exclude-ip=${HP_PUBLIC_IP}"
# Suricata's alerts as network.json, with no IPs; the real sshd's port is left out (see network.py).
ExecStartPost=-/usr/bin/python3 /opt/uig-honeypot/network.py \
  --suricata-logs /var/log/suricata --cowrie-logs data/var/log/cowrie --out data/network.json \
  --geoip data/geoip/dbip-city-lite.mmdb "--redact=${HP_PUBLIC_IP}" "--exclude-ip=${HP_PUBLIC_IP}" \
  "--hide-port=${HP_SSH_PORT}"
# Publishing is best effort: a GitHub outage must not fail the stats run.
ExecStartPost=-/opt/uig-honeypot/publish.sh
Nice=10
